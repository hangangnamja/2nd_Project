# Unity 자동 생성 폴더 (프로젝트를 열면 다시 만들어짐)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store 도구
/[Aa]ssets/AssetStoreTools*

# Visual Studio / VS Code / Rider 생성 파일
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 메타데이터 디버그 파일
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 크래시 리포트
sysinfo.txt

# 빌드 결과물
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# 자동 생성 에셋
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS 파일
.DS_Store
Thumbs.db
Desktop.ini

# 엑셀이 열려 있을 때 생기는 잠금 파일
~$*

# Unity가 강제 종료 때 남기는 씬 백업
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# 외부 모델·애니메이션 (에셋 스토어·Mixamo 원본은 라이선스상 레포에 올리지 않음, 로컬에만 둠)
/[Aa]ssets/3Dmodels/
/[Aa]ssets/3Dmodels.meta
